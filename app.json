{
  "expo": {
    "name": "Nuba TV",
    "slug": "nuba-tv",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#030612"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nuba.tv"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#030612"
      },
      "package": "com.nuba.tv",
      "intentFilters": [
        {
          "action": "MAIN",
          "category": [
            "LEANBACK_LAUNCHER",
            "LAUNCHER"
          ]
        }
      ],
      "versionCode": 1,
      "permissions": []
    },
    "plugins": [
      "./withTvBanner.js",
      "expo-router",
      "expo-font",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "LANDSCAPE"
        }
      ],
      "react-native-video",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "nubatv",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0e3c8617-e1db-466e-ad9c-02bce8c6ae7e"
      }
    }
  }
}
